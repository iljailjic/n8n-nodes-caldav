# Copy this file to .env.icloud-e2e and replace every placeholder locally.
# The real file is ignored by Git and must never be committed.
CALDAV_ICLOUD_E2E_SERVER_URL=https://caldav.icloud.com/
CALDAV_ICLOUD_E2E_USERNAME=dedicated-apple-account@example.com
CALDAV_ICLOUD_E2E_APP_PASSWORD=replace-with-apple-app-specific-password
CALDAV_ICLOUD_E2E_CALENDAR_DISPLAY_NAME=CalDAV E2E
