{
	"name": "@iljailjic/n8n-nodes-caldav",
	"version": "0.1.0",
	"description": "CalDAV community node for n8n with iCloud-first interoperability",
	"license": "MIT",
	"homepage": "https://github.com/iljailjic/n8n-nodes-caldav#readme",
	"bugs": {
		"url": "https://github.com/iljailjic/n8n-nodes-caldav/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iljailjic/n8n-nodes-caldav.git"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"caldav",
		"calendar",
		"icloud",
		"webdav",
		"automation",
		"typescript"
	],
	"author": {
		"name": "Martin Kováčik",
		"email": "martin.kovacik@seznam.cz"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/CalDav/CalDav.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.9.6",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
