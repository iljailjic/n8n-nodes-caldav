{
	"name": "@iljailjic/n8n-nodes-caldav",
	"version": "1.0.0-beta.1",
	"description": "CalDAV community node for n8n with iCloud-first interoperability",
	"license": "MIT",
	"homepage": "https://github.com/iljailjic/n8n-nodes-caldav#readme",
	"bugs": {
		"url": "https://github.com/iljailjic/n8n-nodes-caldav/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iljailjic/n8n-nodes-caldav.git"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"caldav",
		"calendar",
		"icloud",
		"webdav",
		"automation",
		"typescript"
	],
	"author": {
		"name": "Martin Kováčik",
		"email": "martin.kovacik@seznam.cz"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run --config vitest.config.mts && npm run test:integration",
		"test:e2e:icloud": "CALDAV_ICLOUD_E2E_OPT_IN=0 node --env-file-if-exists=.env.icloud-e2e ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.mts && CALDAV_ICLOUD_E2E_OPT_IN=1 node --env-file-if-exists=.env.icloud-e2e ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.mts",
		"test:e2e:icloud:dry-run": "CALDAV_ICLOUD_E2E_OPT_IN=0 node --env-file-if-exists=.env.icloud-e2e ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.mts",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"test:watch": "vitest watch --config vitest.config.mts",
		"verify:package": "node scripts/verify-package-contents.mjs && node scripts/verify-package-clean-host.mjs",
		"verify:package:clean-host": "node scripts/verify-package-clean-host.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22 <25"
	},
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CalDavApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CalDav/CalDav.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.9.6",
		"release-it": "^21.0.2",
		"typescript": "5.9.2",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
